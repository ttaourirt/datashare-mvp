# Configuration du déploiement Docker.
# À copier en .env (./scripts/deploy.sh le fait tout seul et génère le secret JWT).
# Ne jamais committer le fichier .env.

# Base de données PostgreSQL (prises en compte à la première création de la base)
DB_USER=datashare
DB_PASSWORD=datashare

# Secret qui signe les jetons JWT : 32 caractères minimum, à garder secret
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire-de-32-caracteres-minimum
